From 0e7b61c9864e1fcc2597da072ed8f370853f7c22 Mon Sep 17 00:00:00 2001
From: Pharos Peng <q1293132751@163.com>
Date: Thu, 27 Aug 2026 00:45:45 +0800
Subject: [PATCH] Add Sarathi scheduler baseline port

---
 tests/v1/core/test_sarathi_scheduler.py | 92 +++++++++++++++++++++++++
 vllm/v1/core/sched/sarathi_scheduler.py | 29 ++++++++
 2 files changed, 121 insertions(+)
 create mode 100644 tests/v1/core/test_sarathi_scheduler.py
 create mode 100644 vllm/v1/core/sched/sarathi_scheduler.py

diff --git a/tests/v1/core/test_sarathi_scheduler.py b/tests/v1/core/test_sarathi_scheduler.py
new file mode 100644
index 000000000..dd10ea8ea
--- /dev/null
+++ b/tests/v1/core/test_sarathi_scheduler.py
@@ -0,0 +1,92 @@
+from __future__ import annotations
+
+import importlib.util
+import sys
+from pathlib import Path
+from types import ModuleType, SimpleNamespace
+
+import pytest
+
+
+class _Scheduler:
+    def __init__(self, *_args: object, **_kwargs: object) -> None:
+        pass
+
+
+_SCHEDULER_MODULE = ModuleType("vllm.v1.core.sched.scheduler")
+_SCHEDULER_MODULE.Scheduler = _Scheduler
+sys.modules[_SCHEDULER_MODULE.__name__] = _SCHEDULER_MODULE
+
+_SOURCE = (
+    Path(__file__).parents[3]
+    / "vllm"
+    / "v1"
+    / "core"
+    / "sched"
+    / "sarathi_scheduler.py"
+)
+_SPEC = importlib.util.spec_from_file_location("sarathi_scheduler_test", _SOURCE)
+assert _SPEC is not None and _SPEC.loader is not None
+_MODULE = importlib.util.module_from_spec(_SPEC)
+_SPEC.loader.exec_module(_MODULE)
+SarathiSchedulerPort = _MODULE.SarathiSchedulerPort
+
+
+def _install_scheduler_stub(
+    monkeypatch: pytest.MonkeyPatch,
+    *,
+    chunked_prefill: bool,
+    token_budget: int,
+) -> None:
+    def _initialize(instance: _Scheduler, *_args: object, **_kwargs: object) -> None:
+        instance.scheduler_config = SimpleNamespace(
+            enable_chunked_prefill=chunked_prefill
+        )
+        instance.max_num_scheduled_tokens = token_budget
+
+    monkeypatch.setattr(_Scheduler, "__init__", _initialize)
+
+
+def test_sarathi_port_requires_chunked_prefill(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    _install_scheduler_stub(
+        monkeypatch,
+        chunked_prefill=False,
+        token_budget=512,
+    )
+
+    with pytest.raises(ValueError, match="requires chunked prefill"):
+        SarathiSchedulerPort()
+
+
+def test_sarathi_port_requires_frozen_chunk_budget(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    _install_scheduler_stub(
+        monkeypatch,
+        chunked_prefill=True,
+        token_budget=1024,
+    )
+
+    with pytest.raises(ValueError, match="max-num-batched-tokens=512"):
+        SarathiSchedulerPort()
+
+
+def test_sarathi_port_emits_component_receipt(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    _install_scheduler_stub(
+        monkeypatch,
+        chunked_prefill=True,
+        token_budget=512,
+    )
+
+    scheduler = SarathiSchedulerPort()
+
+    assert scheduler.get_baseline_scheduler_receipt() == {
+        "scheduler_type": "sarathi",
+        "chunk_size": 512,
+        "dynamic_chunking_schedule": False,
+        "decode_first": True,
+    }
diff --git a/vllm/v1/core/sched/sarathi_scheduler.py b/vllm/v1/core/sched/sarathi_scheduler.py
new file mode 100644
index 000000000..cadca5cc7
--- /dev/null
+++ b/vllm/v1/core/sched/sarathi_scheduler.py
@@ -0,0 +1,29 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Sarathi-Serve stall-free scheduling component port for V1 vLLM."""
+
+from __future__ import annotations
+
+from vllm.v1.core.sched.scheduler import Scheduler
+
+SARATHI_FIXED_CHUNK_SIZE = 512
+
+
+class SarathiSchedulerPort(Scheduler):
+    """Run V1's decode-first scheduler with Sarathi's fixed chunk budget."""
+
+    def __init__(self, *args, **kwargs) -> None:
+        super().__init__(*args, **kwargs)
+        if not self.scheduler_config.enable_chunked_prefill:
+            raise ValueError("SarathiSchedulerPort requires chunked prefill")
+        if self.max_num_scheduled_tokens != SARATHI_FIXED_CHUNK_SIZE:
+            raise ValueError("SarathiSchedulerPort requires max-num-batched-tokens=512")
+        self.sarathi_scheduler_receipt = {
+            "scheduler_type": "sarathi",
+            "chunk_size": SARATHI_FIXED_CHUNK_SIZE,
+            "dynamic_chunking_schedule": False,
+            "decode_first": True,
+        }
+
+    def get_baseline_scheduler_receipt(self) -> dict[str, object]:
+        return dict(self.sarathi_scheduler_receipt)
