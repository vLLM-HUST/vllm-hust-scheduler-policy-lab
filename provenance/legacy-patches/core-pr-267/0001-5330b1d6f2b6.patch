+        self,
+        max_num_scheduled_tokens: int,
+        max_num_running_reqs: int,
+    ) -> dict[str, int | dict[str, int]]:
+        raise NotImplementedError
+
+    @abstractmethod
+    def stage_runtime_scheduler_limits(
+        self,
+        max_num_scheduled_tokens: int,
+        max_num_running_reqs: int,
+    ) -> dict[str, int | dict[str, int]]:
